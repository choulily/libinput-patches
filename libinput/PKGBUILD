# Maintainer: Lily Chou <lily-develop@outlook.com>
#
# libinput with Synaptics-style circular scrolling and pointer momentum.
#
# REPLACES the stock Arch libinput packages. Arch splits libinput into
# libinput / libinput-udev / libinput-docs; anything depending on those
# would otherwise pull stock libinput back in on the next upgrade and
# silently remove the features. So this package provides all three and
# ships their files.
#
# Settings are NOT part of this package:
#   /etc/libinput/local-overrides.quirks   (per-device settings)
#   ~/.config/kcminputrc                   (ScrollMethod)
# Both are configuration, so upgrading or reinstalling this package leaves
# them untouched.
#
# Building: this PKGBUILD expects a source tarball next to it, named
# $_tarball. Create one from the repository root with:
#
#   git archive --prefix=libinput-fork-$pkgver/ -o PKGBUILD/libinput-fork-$pkgver.tar.gz HEAD
#
# Nothing here ever writes into the source tree, so a failed build cannot
# damage a checkout.

pkgname=libinput-fork
pkgver=1.32.0
pkgrel=1
pkgdesc="libinput with circular scrolling and pointer momentum"
arch=('x86_64')
url="https://github.com/choulily/libinput-patches"
license=('MIT')
depends=('libevdev' 'libwacom' 'mtdev' 'systemd-libs' 'glib2')
makedepends=('meson' 'ninja' 'git' 'python' 'pkgconf')
# libinput-tools ships the libinput(1) CLI and its man pages, which this
# package also installs; without conflicting with it, pacman refuses the
# transaction on file overlap.
provides=('libinput' 'libinput-udev' 'libinput-docs' 'libinput-tools')
conflicts=('libinput' 'libinput-udev' 'libinput-docs' 'libinput-tools')
replaces=('libinput' 'libinput-udev' 'libinput-tools')
options=('debug')

_tarball="libinput-fork-$pkgver.tar.gz"
source=("$_tarball")
sha256sums=('SKIP')

build() {
	cd "$srcdir/$pkgname-$pkgver"

	mkdir -p build
	arch-meson . build \
		-Ddocumentation=false \
		-Dtests=false \
		-Ddebug-gui=false \
		-Dlibwacom=true \
		-Dudev-dir=/usr/lib/udev
	ninja -C build
}

package() {
	cd "$srcdir/$pkgname-$pkgver"

	DESTDIR="$pkgdir" ninja -C build install

	# The stock package creates this empty directory; tools expect it.
	install -dm755 "$pkgdir/etc/libinput"

	# A valid quirk database cannot contain a section with only comments,
	# so the example lives in the doc directory rather than
	# /usr/share/libinput where libinput would try to parse it.
	install -Dm644 examples/fork-quirks-example.quirks \
		"$pkgdir/usr/share/doc/$pkgname/fork-quirks-example.quirks"

	install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/README" <<-EOF
	${pkgname} ${pkgver}-${pkgrel}

	This package replaces libinput, libinput-udev and libinput-docs and
	provides their files. Keep it installed or the touchpad loses
	circular scrolling and pointer momentum.

	What it adds
	  Circular scrolling: draw circles on the edge to scroll. Follows
	  xf86-input-synaptics: latched per touch, distance from the angle
	  travelled, so small circles scroll faster.

	  Pointer momentum: a fast flick keeps the cursor gliding.

	Settings
	  /etc/libinput/local-overrides.quirks   system, needs root
	  ~/.config/kcminputrc                   per user (ScrollMethod)

	  KDE: install kcm-libinput-fork, then System Settings ->
	       Input Devices -> Touchpad Gestures (Fork).

	  Other desktops: write the quirk file directly, or on sway use
	  "scroll_method circular". See fork-quirks-example.quirks.

	Circular scrolling is a scroll method (value 8), which unpatched KWin
	already applies from kcminputrc. No compositor patch is needed.

	Upgrading libinput upstream does not overwrite this package, because
	it provides the same package names.
	EOF
}
