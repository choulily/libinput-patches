diff --git a/sway/commands/input/circular_scrolling.c b/sway/commands/input/circular_scrolling.c
new file mode 100644
index 0000000..0f39456
--- /dev/null
+++ b/sway/commands/input/circular_scrolling.c
@@ -0,0 +1,109 @@
+#define _POSIX_C_SOURCE 200809L
+#include <libinput.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/input/input-manager.h"
+#include "util.h"
+
+struct cmd_results *input_cmd_circular_scrolling(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "circular_scrolling", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct input_config *ic = config->handler_context.input_config;
+	if (!ic) {
+		return cmd_results_new(CMD_FAILURE, "No input device defined.");
+	}
+
+#if HAVE_LIBINPUT_FORK
+	if (strcasecmp(argv[0], "enabled") == 0) {
+		ic->scroll_method = LIBINPUT_CONFIG_SCROLL_CIRCULAR;
+	} else if (strcasecmp(argv[0], "disabled") == 0) {
+		ic->scroll_method = LIBINPUT_CONFIG_SCROLL_2FG;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+			"Expected 'circular_scrolling <enabled|disabled>'");
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+#else
+	return cmd_results_new(CMD_FAILURE,
+		"circular_scrolling requires libinput with the fork's "
+		"circular scrolling support");
+#endif
+}
+
+struct cmd_results *input_cmd_circular_scroll_trigger(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "circular_scroll_trigger",
+			EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct input_config *ic = config->handler_context.input_config;
+	if (!ic) {
+		return cmd_results_new(CMD_FAILURE, "No input device defined.");
+	}
+
+#if HAVE_LIBINPUT_FORK
+	static const struct {
+		const char *name;
+		int value;
+	} triggers[] = {
+		{ "any_edge", 0 },
+		{ "top_edge", 1 },
+		{ "top_right_corner", 2 },
+		{ "right_edge", 3 },
+		{ "bottom_right_corner", 4 },
+		{ "bottom_edge", 5 },
+		{ "bottom_left_corner", 6 },
+		{ "left_edge", 7 },
+		{ "top_left_corner", 8 },
+	};
+
+	for (size_t i = 0; i < sizeof(triggers) / sizeof(triggers[0]); i++) {
+		if (strcasecmp(argv[0], triggers[i].name) == 0) {
+			ic->circular_scroll_trigger = triggers[i].value;
+			return cmd_results_new(CMD_SUCCESS, NULL);
+		}
+	}
+
+	return cmd_results_new(CMD_INVALID,
+		"Expected 'circular_scroll_trigger <any_edge|top_edge|"
+		"top_right_corner|right_edge|bottom_right_corner|bottom_edge|"
+		"bottom_left_corner|left_edge|top_left_corner>'");
+#else
+	return cmd_results_new(CMD_FAILURE,
+		"circular_scroll_trigger requires libinput with the fork's "
+		"circular scrolling support");
+#endif
+}
+
+struct cmd_results *input_cmd_circular_scroll_distance(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "circular_scroll_distance",
+			EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct input_config *ic = config->handler_context.input_config;
+	if (!ic) {
+		return cmd_results_new(CMD_FAILURE, "No input device defined.");
+	}
+
+#if HAVE_LIBINPUT_FORK
+	float distance = parse_float(argv[0]);
+	if (isnan(distance)) {
+		return cmd_results_new(CMD_INVALID, "Invalid distance '%s'", argv[0]);
+	} else if (distance <= 0.0f) {
+		return cmd_results_new(CMD_INVALID,
+			"Distance must be greater than 0 degrees");
+	}
+	ic->circular_scroll_distance = distance;
+	return cmd_results_new(CMD_SUCCESS, NULL);
+#else
+	return cmd_results_new(CMD_FAILURE,
+		"circular_scroll_distance requires libinput with the fork's "
+		"circular scrolling support");
+#endif
+}
diff --git a/sway/commands/input/pointer_momentum.c b/sway/commands/input/pointer_momentum.c
new file mode 100644
index 0000000..a6fac3f
--- /dev/null
+++ b/sway/commands/input/pointer_momentum.c
@@ -0,0 +1,90 @@
+#include <libinput.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/input/input-manager.h"
+#include "util.h"
+
+struct cmd_results *input_cmd_pointer_momentum(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "pointer_momentum", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct input_config *ic = config->handler_context.input_config;
+	if (!ic) {
+		return cmd_results_new(CMD_FAILURE, "No input device defined.");
+	}
+
+#if HAVE_LIBINPUT_FORK
+	if (strcasecmp(argv[0], "enabled") == 0) {
+		ic->pointer_momentum = 1;
+	} else if (strcasecmp(argv[0], "disabled") == 0) {
+		ic->pointer_momentum = 0;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+			"Expected 'pointer_momentum <enabled|disabled>'");
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+#else
+	return cmd_results_new(CMD_FAILURE,
+		"pointer_momentum requires libinput with the fork's momentum support");
+#endif
+}
+
+struct cmd_results *input_cmd_pointer_momentum_strength(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "pointer_momentum_strength",
+			EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct input_config *ic = config->handler_context.input_config;
+	if (!ic) {
+		return cmd_results_new(CMD_FAILURE, "No input device defined.");
+	}
+
+#if HAVE_LIBINPUT_FORK
+	char *end;
+	long strength = strtol(argv[0], &end, 10);
+	if (*end != '\0') {
+		return cmd_results_new(CMD_INVALID, "Invalid strength '%s'", argv[0]);
+	} else if (strength < 10 || strength > 400) {
+		return cmd_results_new(CMD_INVALID,
+			"Strength must be between 10 and 400");
+	}
+	ic->pointer_momentum_strength = strength;
+	return cmd_results_new(CMD_SUCCESS, NULL);
+#else
+	return cmd_results_new(CMD_FAILURE,
+		"pointer_momentum_strength requires libinput with the fork's "
+		"momentum support");
+#endif
+}
+
+struct cmd_results *input_cmd_pointer_momentum_min_velocity(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "pointer_momentum_min_velocity",
+			EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct input_config *ic = config->handler_context.input_config;
+	if (!ic) {
+		return cmd_results_new(CMD_FAILURE, "No input device defined.");
+	}
+
+#if HAVE_LIBINPUT_FORK
+	float velocity = parse_float(argv[0]);
+	if (isnan(velocity)) {
+		return cmd_results_new(CMD_INVALID, "Invalid velocity '%s'", argv[0]);
+	} else if (velocity < 0.0f) {
+		return cmd_results_new(CMD_INVALID, "Velocity must not be negative");
+	}
+	ic->pointer_momentum_min_velocity = velocity;
+	return cmd_results_new(CMD_SUCCESS, NULL);
+#else
+	return cmd_results_new(CMD_FAILURE,
+		"pointer_momentum_min_velocity requires libinput with the fork's "
+		"momentum support");
+#endif
+}
