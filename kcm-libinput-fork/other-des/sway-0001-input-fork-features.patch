+			libinput_device_config_circular_scroll_get_trigger(dev) == trigger) {
+		return false;
+	}
+	sway_log(SWAY_DEBUG, "circular_scroll_set_trigger(%d)", trigger);
+	log_status(libinput_device_config_circular_scroll_set_trigger(dev, trigger));
+	return true;
